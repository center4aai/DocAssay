    "unused-parameter": {"unit": "method", "scope": "out", "artifact_class": null, "aliases": ["docprism:Unused Parameter or Variable"]},
    "copy-edit-drift": {"unit": "repo", "scope": "out", "artifact_class": null, "aliases": ["readu:Typo, Grammar, and Minor Copy-Editing", "dca_bench:typo"]},
    "error-message-drift": {"unit": "repo", "scope": "candidate", "artifact_class": null, "aliases": ["readu_raw:quoted error message string changed"]},

    "presentation-format": {"unit": "doc", "scope": "out", "artifact_class": null, "aliases": ["dca_bench:wrong-format", "aghajani_2019:information content (how)"]},
    "documentation-process": {"unit": "process", "scope": "out", "artifact_class": null, "aliases": ["aghajani_2019:Documentation process"]},
    "documentation-tooling": {"unit": "tool", "scope": "out", "artifact_class": null, "aliases": ["aghajani_2019:Documentation tool support"]},
    "data-quality": {"unit": "data", "scope": "out", "artifact_class": null, "aliases": ["dca_bench:data-problem", "dca_bench:inappropriate-file"]},

    "control-pre-existing": {"unit": "repo", "scope": "control", "artifact_class": null, "aliases": ["readu:Pre-existing"]},
    "control-misinterpreted": {"unit": "repo", "scope": "control", "artifact_class": null, "aliases": ["readu:Misinterpreted Implementation Context or Semantics"]},
    "control-illustrative": {"unit": "repo", "scope": "control", "artifact_class": null, "aliases": ["readu:Intentionally Non-Exhaustive or Illustrative Documentation"]},
    "control-benign-equivalence": {"unit": "repo", "scope": "control", "artifact_class": null, "aliases": ["readu:Benign Equivalence, Wording, or Optionality"]},
    "control-incorrect-external": {"unit": "repo", "scope": "control", "artifact_class": null, "aliases": ["readu:Incorrect External Evidence or Source of Truth"]},
    "control-repair-failure": {"unit": "repair", "scope": "out", "artifact_class": null, "aliases": ["readu:repair failure themes"]},

    "rubric-correctness": {"unit": "rubric", "scope": "control", "artifact_class": null, "aliases": ["readu-rubric:Correctness"]},
    "rubric-up-to-date": {"unit": "rubric", "scope": "control", "artifact_class": null, "aliases": ["readu-rubric:Up-to-date-ness"]},
    "rubric-completeness": {"unit": "rubric", "scope": "control", "artifact_class": null, "aliases": ["readu-rubric:Completeness"]},
    "axis-commit-induced": {"unit": "rubric", "scope": "control", "artifact_class": null, "aliases": ["readu-rubric:Commit-induced vs pre-existing"]}
  }
