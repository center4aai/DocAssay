    "null-semantics-drift": {"unit": "method", "scope": "out", "artifact_class": null, "aliases": ["cascade:null/absent-value contract changed"]},
    "format-encoding-drift": {"unit": "method", "scope": "out", "artifact_class": null, "aliases": ["cascade:format / encoding / unit drift"]},
    "polarity-order-drift": {"unit": "method", "scope": "out", "artifact_class": null, "aliases": ["cascade:polarity / order drift"]},
    "lifecycle-contract-drift": {"unit": "method", "scope": "out", "artifact_class": null, "aliases": ["cascade:precondition / lifecycle contract drift"]},
    "return-value-semantics-drift": {"unit": "method", "scope": "out", "artifact_class": null, "aliases": ["cascade:return-value semantics"]},
