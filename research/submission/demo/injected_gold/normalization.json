    "type-drift": {"unit": "repo", "scope": "in", "artifact_class": "type", "aliases": ["docprism:Parameter Type Mismatch", "docprism:Return Type Mismatch", "vasperabench:type_mismatch", "cascade:return type"]},
    "schema-field-drift": {"unit": "repo", "scope": "in", "artifact_class": "schema_field", "aliases": ["readu_raw:request/response schema field added/removed/renamed"]},
    "membership-drift": {"unit": "repo", "scope": "in", "artifact_class": "membership", "aliases": ["cascade:membership"]},
    "external-dependency-drift": {"unit": "repo", "scope": "in", "artifact_class": "dependency", "aliases": ["readu:External Dependency"]},
    "missing-documentation": {"unit": "repo", "scope": "in", "artifact_class": "omission", "aliases": ["readu:Missing or Incomplete API/Feature Documentation", "mpc_2025:Missing Documentation", "vasperabench:undocumented", "dca_bench:document-problem", "readme_auto_update:README should be updated"]},
    "invalid-example-instruction": {"unit": "repo", "scope": "in", "artifact_class": "example", "aliases": ["readu:Invalid Copy-Paste Code, Command, or Setup Instructions", "readu_raw:documented command/flags changed", "cascade:example"]},
