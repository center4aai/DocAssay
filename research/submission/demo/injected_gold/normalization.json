    "translation-drift": {"unit": "repo", "scope": "in", "artifact_class": "cross_doc", "aliases": ["readu:translation"]},
    "license-drift": {"unit": "repo", "scope": "in", "artifact_class": "license", "aliases": []},
    "dockerfile-drift": {"unit": "repo", "scope": "in", "artifact_class": "dockerfile", "aliases": []},
    "ci-workflow-drift": {"unit": "repo", "scope": "in", "artifact_class": "ci_workflow", "aliases": []},

    "behavior-drift": {"unit": "behavior", "scope": "out", "artifact_class": null, "aliases": ["mpc_2025:Logic Change", "docprism:Functionality Mismatch", "vasperabench:behavior_change", "truth_benchmark:wrong operators/constants", "wen_2019:code-comment inconsistency types"]},
    "signature-drift": {"unit": "behavior", "scope": "out", "artifact_class": null, "aliases": ["vasperabench:signature_change"]},
