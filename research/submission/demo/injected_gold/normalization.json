{
  "schema_version": "2.0",
  "overlay_id": "injected_gold.normalization",
  "version": "2026-10-07",
  "note": "Overlay mapping canonical classes -> unit/scope/artifact_class and their source-label aliases. The catalog keeps source labels verbatim; analysis uses these canonicals. artifact_class is an external domain concept (not an engine predicate); predicate mapping lives in coverage.py as a post-freeze measurement.",
  "canonical_classes": {
    "value-drift": {"unit": "repo", "scope": "in", "artifact_class": "value", "aliases": ["readu:Implementation-Documentation Drift", "mpc_2025:Value Change", "mpc_2025:Modify Description", "vasperabench:value_mismatch", "cascade:default/range"]},
    "config-key-drift": {"unit": "repo", "scope": "in", "artifact_class": "config_key", "aliases": ["readu_raw:env var / feature flag / config option", "vasperabench:config_mismatch"]},
    "identifier-drift": {"unit": "repo", "scope": "in", "artifact_class": "identifier", "aliases": ["readu_raw:UI strings / entity naming drift", "mpc_2025:Parameter name change", "docprism:Identifier Mismatch"]},
    "path-location-drift": {"unit": "repo", "scope": "in", "artifact_class": "path", "aliases": ["readu:path/location", "docer:stale code-element reference"]},
    "api-endpoint-drift": {"unit": "repo", "scope": "in", "artifact_class": "endpoint", "aliases": ["readu_raw:API endpoint path added/removed/renamed"]},
